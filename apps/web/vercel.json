{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @chore-wheel/database db:migrate && next build",
  "crons": [
    {
      "path": "/api/jobs/assign-chores",
      "schedule": "0 8 * * *"
    }
  ]
}
